{
  "name": "alexandria-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-two-ships.mjs",
    "dev:bus": "VITE_URBIT_SHIP=~bus VITE_URBIT_URL=http://localhost VITE_URBIT_SHIP_URLS='{\"~bus\":\"http://localhost\",\"~zod\":\"http://localhost:8080\"}' vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:zod": "VITE_URBIT_SHIP=~zod VITE_URBIT_URL=http://localhost:8080 VITE_URBIT_SHIP_URLS='{\"~bus\":\"http://localhost\",\"~zod\":\"http://localhost:8080\"}' vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.76.1",
    "@urbit/http-api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
